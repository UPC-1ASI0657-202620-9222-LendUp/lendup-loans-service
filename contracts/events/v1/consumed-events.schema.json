{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lendup.example/contracts/events/v1/loans-consumed-events.schema.json",
  "title": "Events consumed by Loans v1",
  "description": "Campos que usa Préstamos. Reservas y Pagos ya publican los suyos (los esquemas completos están en sus repositorios). Los de Evidencias son contratos PROPUESTOS: su productor (monolito) todavía no existe y sus routing keys son configurables. El consumidor despacha por routing key.",
  "type": "object",
  "required": ["event_id", "payload"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "type": "string" },
    "event_version": { "const": 1 },
    "aggregate_version": { "type": "integer", "minimum": 0 },
    "aggregate_id": { "type": "string", "format": "uuid" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "correlation_id": { "type": "string" },
    "payload": { "type": "object" }
  },
  "$defs": {
    "reservaConfirmada": {
      "description": "reservas.confirmada.v1 (Reservas, disponible). Crea el préstamo.",
      "type": "object",
      "required": ["reserva_id", "publicacion_id", "prestamista_usuario_id", "prestatario_usuario_id", "desde", "hasta", "tarifa_diaria_acordada", "moneda_acordada"],
      "properties": {
        "reserva_id": { "type": "string", "format": "uuid" }, "publicacion_id": { "type": "string", "format": "uuid" },
        "prestamista_usuario_id": { "type": "string", "format": "uuid" }, "prestatario_usuario_id": { "type": "string", "format": "uuid" },
        "desde": { "type": "string", "format": "local-date-time" }, "hasta": { "type": "string", "format": "local-date-time" },
        "tarifa_diaria_acordada": { "type": "number", "exclusiveMinimum": 0 }, "garantia_monetaria_acordada": { "type": ["number", "null"], "minimum": 0 },
        "moneda_acordada": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    },
    "cancelacionSolicitada": { "description": "reservas.cancelacion-solicitada.v1 (Reservas, disponible). Saga de cancelación, paso 2.", "type": "object", "required": ["reserva_id"], "properties": { "reserva_id": { "type": "string", "format": "uuid" } } },
    "reservaCancelada": { "description": "reservas.cancelada.v1 (Reservas, disponible).", "type": "object", "required": ["reserva_id"], "properties": { "reserva_id": { "type": "string", "format": "uuid" } } },
    "pagoConfirmado": {
      "description": "pagos.pago-confirmado.v1 (Pagos, disponible). PAGO_TARIFA habilita la entrega; PAGO_EXTENSION aplica la extensión.",
      "type": "object", "required": ["prestamo_id", "tipo"],
      "properties": {
        "prestamo_id": { "type": "string", "format": "uuid" }, "tipo": { "enum": ["PAGO_TARIFA", "PAGO_EXTENSION"] },
        "cambio_fecha_prestamo_id": { "type": "string", "format": "uuid", "description": "Obligatorio en PAGO_EXTENSION" },
        "transaccion_id": { "type": "string", "format": "uuid" }, "confirmada_en": { "type": "string", "format": "date-time" }
      }
    },
    "pagoRechazado": { "description": "pagos.pago-rechazado.v1 (Pagos, disponible). Solo se audita.", "type": "object", "required": ["prestamo_id"], "properties": { "prestamo_id": { "type": "string", "format": "uuid" }, "tipo": { "type": "string" } } },
    "garantiaConstituida": { "description": "pagos.garantia-constituida.v1 (Pagos, disponible).", "type": "object", "required": ["prestamo_id"], "properties": { "prestamo_id": { "type": "string", "format": "uuid" }, "constituida_en": { "type": "string", "format": "date-time" } } },
    "incidencia": {
      "description": "PENDIENTE (Evidencias). INCIDENT_REPORTED_ROUTING_KEY=evidencias.incidencia-reportada.v1 e INCIDENT_RESOLVED_ROUTING_KEY=evidencias.incidencia-resuelta.v1.",
      "type": "object", "required": ["prestamo_id"],
      "properties": { "incidencia_id": { "type": "string", "format": "uuid" }, "prestamo_id": { "type": "string", "format": "uuid" } }
    }
  }
}
