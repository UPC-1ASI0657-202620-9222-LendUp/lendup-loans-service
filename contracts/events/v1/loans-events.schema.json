{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lendup.example/contracts/events/v1/loans-events.schema.json",
  "title": "LendUp Loans emitted event envelope v1",
  "description": "Envelope estándar de lendup.domain.events. Routing key: prestamos.<evento>.v1. Las fechas pactadas (local-date-time) son hora de negocio America/Lima; el resto son instantes UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "event_version", "aggregate_version", "aggregate_id", "occurred_at", "correlation_id", "payload"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "enum": ["PrestamoCreado", "ObjetoEntregado", "PrestamoActivado", "ExtensionSolicitada", "ExtensionAceptada", "ExtensionRechazada", "ReprogramacionPropuesta", "ReprogramacionRechazada", "FechaDevolucionActualizada", "DevolucionRegistrada", "PrestamoVencido", "PrestamoFinalizado", "PrestamoCancelado", "CancelacionRechazada", "PeriodoPrestamoLiberado", "ExtensionRetencionSolicitada", "ExtensionConfirmacionSolicitada", "ExtensionRetencionCancelada", "RecuperacionPendiente"] },
    "event_version": { "const": 1 },
    "aggregate_version": { "type": "integer", "minimum": 1, "description": "Versión del préstamo: crece con cada cambio." },
    "aggregate_id": { "type": "string", "format": "uuid", "description": "prestamo_id" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "correlation_id": { "type": "string", "maxLength": 100 },
    "payload": { "type": "object" }
  },
  "allOf": [
    { "properties": { "payload": { "$ref": "#/$defs/base" } } },
    { "if": { "properties": { "event_type": { "const": "ExtensionRetencionSolicitada" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/comandoOcupacion" } } } },
    { "if": { "properties": { "event_type": { "const": "ExtensionConfirmacionSolicitada" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/comandoOcupacion" } } } },
    { "if": { "properties": { "event_type": { "const": "ExtensionRetencionCancelada" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/comandoOcupacion" } } } },
    { "if": { "properties": { "event_type": { "const": "RecuperacionPendiente" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/recuperacion" } } } },
    { "if": { "properties": { "event_type": { "const": "PrestamoCreado" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/creado" } } } },
    { "if": { "properties": { "event_type": { "const": "ObjetoEntregado" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/entregado" } } } },
    { "if": { "properties": { "event_type": { "const": "PrestamoActivado" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/activado" } } } },
    { "if": { "properties": { "event_type": { "const": "ExtensionSolicitada" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/extensionSolicitada" } } } },
    { "if": { "properties": { "event_type": { "const": "ExtensionAceptada" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/extensionAceptada" } } } },
    { "if": { "properties": { "event_type": { "const": "ExtensionRechazada" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/cambioRechazado" } } } },
    { "if": { "properties": { "event_type": { "const": "ReprogramacionPropuesta" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/reprogramacionPropuesta" } } } },
    { "if": { "properties": { "event_type": { "const": "ReprogramacionRechazada" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/cambioRechazado" } } } },
    { "if": { "properties": { "event_type": { "const": "FechaDevolucionActualizada" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/fechaDevolucionActualizada" } } } },
    { "if": { "properties": { "event_type": { "const": "DevolucionRegistrada" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/devolucionRegistrada" } } } },
    { "if": { "properties": { "event_type": { "const": "PrestamoVencido" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/vencido" } } } },
    { "if": { "properties": { "event_type": { "const": "PrestamoFinalizado" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/finalizado" } } } },
    { "if": { "properties": { "event_type": { "const": "PrestamoCancelado" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/cancelado" } } } },
    { "if": { "properties": { "event_type": { "const": "CancelacionRechazada" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/cancelacionRechazada" } } } },
    { "if": { "properties": { "event_type": { "const": "PeriodoPrestamoLiberado" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/periodoLiberado" } } } }
  ],
  "$defs": {
    "recuperacion": { "type": "object", "required": ["prestamo_id"] },
    "comandoOcupacion": {
      "required": ["cambio_fecha_prestamo_id", "fecha_anterior_en", "fecha_propuesta_en"],
      "properties": {
        "cambio_fecha_prestamo_id": { "type": "string", "format": "uuid" },
        "fecha_anterior_en": { "type": "string", "format": "local-date-time" },
        "fecha_propuesta_en": { "type": "string", "format": "local-date-time" }
      }
    },
    "base": {
      "type": "object",
      "required": ["prestamo_id", "reserva_id", "publicacion_id", "prestatario_usuario_id", "prestamista_usuario_id"],
      "properties": {
        "prestamo_id": { "type": "string", "format": "uuid" }, "reserva_id": { "type": "string", "format": "uuid" }, "publicacion_id": { "type": "string", "format": "uuid" },
        "prestatario_usuario_id": { "type": "string", "format": "uuid" }, "prestamista_usuario_id": { "type": "string", "format": "uuid" }
      }
    },
    "creado": {
      "required": ["entrega_programada_en", "devolucion_original_en", "tarifa_diaria_acordada", "garantia_requerida", "moneda"],
      "properties": {
        "entrega_programada_en": { "type": "string", "format": "local-date-time" }, "devolucion_original_en": { "type": "string", "format": "local-date-time" },
        "tarifa_diaria_acordada": { "type": "number", "exclusiveMinimum": 0 }, "garantia_requerida": { "type": "boolean" },
        "garantia_monetaria_acordada": { "type": "number", "minimum": 0, "description": "Ausente si la reserva no pide garantía" }, "moneda": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    },
    "entregado": { "required": ["entrega_registrada_en"], "properties": { "entrega_registrada_en": { "type": "string", "format": "date-time" } } },
    "activado": { "required": ["activado_en", "devolucion_vigente_en"], "properties": { "activado_en": { "type": "string", "format": "date-time" }, "devolucion_vigente_en": { "type": "string", "format": "local-date-time" } } },
    "extensionSolicitada": {
      "required": ["cambio_fecha_prestamo_id", "fecha_anterior_en", "fecha_propuesta_en", "costo_adicional", "moneda"],
      "properties": {
        "cambio_fecha_prestamo_id": { "type": "string", "format": "uuid" }, "fecha_anterior_en": { "type": "string", "format": "local-date-time" },
        "fecha_propuesta_en": { "type": "string", "format": "local-date-time" }, "costo_adicional": { "type": "number", "exclusiveMinimum": 0 }, "moneda": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    },
    "cambioRechazado": {
      "description": "ExtensionRechazada y ReprogramacionRechazada",
      "required": ["cambio_fecha_prestamo_id"],
      "properties": { "cambio_fecha_prestamo_id": { "type": "string", "format": "uuid" }, "motivo_rechazo": { "type": "string", "description": "Ausente si no se indicó" } }
    },
    "reprogramacionPropuesta": {
      "required": ["cambio_fecha_prestamo_id", "fecha_anterior_en", "fecha_propuesta_en"],
      "properties": {
        "cambio_fecha_prestamo_id": { "type": "string", "format": "uuid" }, "fecha_anterior_en": { "type": "string", "format": "local-date-time" }, "fecha_propuesta_en": { "type": "string", "format": "local-date-time" }
      }
    },
    "fechaDevolucionActualizada": {
      "description": "Extensión pagada o reprogramación aceptada: la fecha vigente ya cambió.",
      "required": ["cambio_fecha_prestamo_id", "tipo", "devolucion_anterior_en", "devolucion_vigente_en"],
      "properties": {
        "cambio_fecha_prestamo_id": { "type": "string", "format": "uuid" }, "tipo": { "enum": ["EXTENSION", "REPROGRAMACION"] },
        "devolucion_anterior_en": { "type": "string", "format": "local-date-time" }, "devolucion_vigente_en": { "type": "string", "format": "local-date-time" }
      }
    },
    "extensionAceptada": {
      "required": ["cambio_fecha_prestamo_id", "costo_adicional", "moneda", "fecha_propuesta_en"],
      "properties": {
        "cambio_fecha_prestamo_id": { "type": "string", "format": "uuid" }, "costo_adicional": { "type": "number", "exclusiveMinimum": 0 },
        "moneda": { "type": "string", "pattern": "^[A-Z]{3}$" }, "fecha_propuesta_en": { "type": "string", "format": "local-date-time" },
        "retencion_expira_en": { "type": "string", "format": "date-time" }
      }
    },
    "devolucionRegistrada": { "required": ["devolucion_registrada_en"], "properties": { "devolucion_registrada_en": { "type": "string", "format": "date-time" } } },
    "vencido": { "required": ["vencido_en", "devolucion_vigente_en"], "properties": { "vencido_en": { "type": "string", "format": "date-time" }, "devolucion_vigente_en": { "type": "string", "format": "local-date-time" } } },
    "finalizado": { "required": ["finalizado_en"], "properties": { "finalizado_en": { "type": "string", "format": "date-time" },
      "incidencias_resueltas": { "type": "array", "uniqueItems": true, "items": { "type": "string", "format": "uuid" } } } },
    "cancelado": { "required": ["cancelado_en"], "properties": { "cancelado_en": { "type": "string", "format": "date-time" } } },
    "cancelacionRechazada": { "required": ["motivo"], "properties": { "motivo": { "type": "string" } } },
    "periodoLiberado": {
      "description": "Contrato de Reservas (loan-events.schema.json): solo se emite si la devolución se confirmó antes del fin del periodo.",
      "required": ["nuevo_hasta", "decision", "devolucion_confirmada_por_prestamista", "incidencias_pendientes"],
      "properties": {
        "nuevo_hasta": { "type": "string", "format": "local-date-time" }, "decision": { "const": "LIBERACION_CONFIRMADA" },
        "devolucion_confirmada_por_prestamista": { "const": true }, "incidencias_pendientes": { "const": false }
      }
    }
  }
}
