SERVER_PORT=8087
DB_URL=jdbc:mysql://mysql:3306/lendup_prestamos?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=lendup_prestamos
DB_PASSWORD=change-me
DB_POOL_MAX_SIZE=20
MYSQL_ROOT_PASSWORD=change-root-me
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=lendup_prestamos
RABBITMQ_PASSWORD=change-me
# Puertos en tu máquina (no chocan con los demás servicios)
MYSQL_HOST_PORT=3313
RABBITMQ_HOST_PORT=5677
RABBITMQ_MANAGEMENT_HOST_PORT=15677
# Proyecto Firebase común del equipo
FIREBASE_PROJECT_ID=lendup-desarrollo
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
FIREBASE_CREDENTIALS_HOST_PATH=./.secrets/firebase-service-account.json
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Identidad. Sin token de servicio se reenvía el Authorization del usuario a GET /api/v1/estudiantes/me. Cuando Identidad
# registre a Préstamos como servicio: IDENTITY_SERVICE_TOKEN y /internal/v1/identidad/firebase/{uid}.
IDENTITY_SERVICE_BASE_URL=http://host.docker.internal:8085
IDENTITY_SERVICE_TOKEN=
IDENTITY_FIREBASE_USER_URI_TEMPLATE=/api/v1/estudiantes/me
# Token con el que Reservas consulta la vigencia del contacto (mínimo 32 caracteres; vacío deshabilita la ruta interna).
# En Reservas: LOAN_SERVICE_TOKEN con el mismo valor y
# LOAN_CONTACT_ACCESS_URI_TEMPLATE=/internal/v1/prestamos/reservas/{reserva_id}/participantes/{usuario_id}/contacto
LOANS_RESERVATIONS_SERVICE_TOKEN=
# Evidencias (opcional): sin configurar, el detalle del préstamo se muestra con evidencias vacías.
EVIDENCE_SERVICE_BASE_URL=
EVIDENCE_LOAN_EVIDENCE_URI_TEMPLATE=
# Routing keys de Evidencias, que todavía no publica sus eventos (contrato pendiente, ver docs/events.md)
INCIDENT_REPORTED_ROUTING_KEY=evidencias.incidencia-reportada.v1
INCIDENT_RESOLVED_ROUTING_KEY=evidencias.incidencia-resuelta.v1
# Copia de PrestamoFinalizado en el formato que exige Reputación (vacía la desactiva)
REPUTATION_LOAN_FINISHED_ROUTING_KEY=loans.loan-finalized.v1
OUTBOX_RELAY_DELAY_MS=1000
OUTBOX_MAX_ATTEMPTS=10
OVERDUE_CHECK_DELAY_MS=60000
OVERDUE_BATCH_SIZE=100
SPRINGDOC_ENABLED=false
SWAGGER_PUBLIC=false
